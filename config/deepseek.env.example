# Minimal DeepSeek config for the new workbench. Copy to .env only if absent.
# Do not add the old template's LLM__MODELS__... entries to this file.
LLM__PROVIDER=deepseek
LLM__BASE_URL=https://api.deepseek.com
LLM__MODEL=deepseek-flash
LLM__API_KEY=
LLM__THINKING_MODE=disabled
LLM__MAX_RETRIES=0
LLM__TIMEOUT_SECONDS=12
